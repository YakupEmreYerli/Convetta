# Bagimliliklar ve uretilen ciktilar
node_modules/
# package-lock.json BILEREK depoda (2026-09-12). Onceden gitignore'daydi; CI, Docker
# ve Dokploy her build'de bagimliliklari sifirdan cozuyordu. 28 Agustos'tan sonra kayan
# 75 paketten biri npm 10'u cokertti ('edgesOut' hatasi) ve ayni commit kirmiziya dondu.
# Kilitsiz build tekrarlanamaz build'dir.
build/
.svelte-kit/
coverage/

# Gizli bilgiler: hicbir .env dosyasi depoya girmemeli. Ornek dosya lazim
# olursa .env.example olarak eklenir, o bilerek disarida birakiliyor.
.env
.env.*
!.env.example

# Claude Code'un yerel dosyalari. Proje geneli ayar, komut ya da beceri
# eklendiginde (.claude/settings.json, .claude/skills/) onlar paylasilabilir;
# burada yalnizca makineye ve oturuma ozel olanlar disarida birakiliyor.
.claude/RESUME.md
.claude/launch.json
.claude/settings.local.json

# Playwright MCP'nin oturum artiklari (ekran goruntusu, konsol ve sayfa anlik goruntuleri)
.playwright-mcp/
playwright-report/
test-results/

# Editor ve isletim sistemi artiklari
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Gunlukler
*.log
npm-debug.log*
